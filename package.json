{
  "name": "all41",
  "description": "All For One — Sardegna, 12-16 agosto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:http": "vite --port 5174",
    "build": "vite build",
    "lint": "oxlint",
    "sql": "node strumenti/unisci-sql.mjs",
    "prova": "npm run --silent prova:conti && npm run --silent prova:proposte && npm run --silent prova:caccia && npm run --silent prova:documenti && npm run --silent prova:posizione && npm run --silent prova:audio && npm run --silent prova:scadenza && npm run --silent prova:coda-foto && npm run --silent prova:scadenza-voti && npm run --silent prova:dispositivo && npm run --silent prova:pecora && npm run --silent prova:impostore && npm run --silent prova:dama && npm run --silent prova:mvp && npm run --silent prova:statistiche",
    "prova:proposte": "node prove/proposte.mjs",
    "prova:conti": "node prove/conti.mjs && node prove/conti-casuali.mjs",
    "prova:caccia": "node prove/caccia.mjs",
    "prova:documenti": "node prove/nome-documento.mjs",
    "prova:posizione": "node prove/rinfresca-posizione.mjs",
    "prova:audio": "node prove/formato-audio.mjs",
    "prova:scadenza": "node prove/scadenza.mjs",
    "prova:coda-foto": "node prove/coda-foto.mjs",
    "prova:scadenza-voti": "node prove/scadenza-voti.mjs",
    "prova:pecora": "node prove/pecora.mjs && node prove/pecora-record.mjs",
    "preview": "vite preview",
    "prova:impostore": "node prove/impostore.mjs && node prove/giri-impostore.mjs",
    "prova:dama": "node prove/dama.mjs && node prove/dama-classifica.mjs",
    "prova:mvp": "node prove/mvp.mjs",
    "prova:statistiche": "node prove/statistiche.mjs",
    "prova:dispositivo": "node prove/dispositivo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "heic-to": "^1.5.2",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  }
