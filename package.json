    "prova:cache": "node prove/cache-scadenza.mjs",
    "prova:giorni": "node prove/giorni.mjs",
    "prova:aggiornamento": "node prove/aggiornamento.mjs",
    "prova:riallineamento": "node prove/riallineamento.mjs",
    "prova:info": "node prove/info.mjs",
    "prova:fogli": "node prove/fogli.mjs",
    "prova:guida": "node prove/guida.mjs",
    "prova:vocali": "node prove/vocali.mjs",
    "prova:sos": "node prove/sos.mjs",
    "prova:avvisi": "node prove/avvisi-rapidi.mjs",
    "prova:dati-vecchi": "node prove/dati-vecchi.mjs",
    "prova:telefono": "node prove/telefono.mjs",
    "prova:finestre": "node prove/finestre-aggiornamento.mjs",
